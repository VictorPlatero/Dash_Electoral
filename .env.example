# Copia este archivo como .env (ignorado por Git) y completa los valores.
# Supabase > Project Settings > API Keys / Data API

# URL del proyecto, sin barra final ni ruta. Ej.: https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Clave publicable (sb_publishable_...): solo lectura de cortes publicados. Se usa en el build.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...): permite escribir. Solo en este equipo; nunca en Render ni en Git.
SUPABASE_SECRET_KEY=
